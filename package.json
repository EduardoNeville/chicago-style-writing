{
  "name": "chicago-style-writing",
  "version": "1.1.0",
  "description": "Write, edit, and audit English prose to The Chicago Manual of Style, 18th edition (2024), and keep AI slop out of any text an agent ships. Ships an agent skill, a judgment checklist, and a deterministic linter with registers.",
  "keywords": [
    "pi-package",
    "agent-skills",
    "chicago",
    "cmos",
    "style",
    "editing",
    "copyediting",
    "writing",
    "prose",
    "slop",
    "lint"
  ],
  "license": "MIT",
  "author": "Eduardo Neville",
  "homepage": "https://github.com/EduardoNeville/chicago-style-writing",
  "repository": {
    "type": "git",
    "url": "https://github.com/EduardoNeville/chicago-style-writing.git"
  },
  "bugs": {
    "url": "https://github.com/EduardoNeville/chicago-style-writing/issues"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "verify": "python3 skills/chicago-style-writing/tests/verify.py",
    "lint": "python3 skills/chicago-style-writing/scripts/cmos_lint.py"
  },
  "files": [
    "skills",
    "README.md",
    "LICENSE"
  ]
